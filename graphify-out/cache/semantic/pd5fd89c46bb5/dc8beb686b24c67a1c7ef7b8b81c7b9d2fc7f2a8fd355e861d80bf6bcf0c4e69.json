{"nodes": [{"id": "templates_admin_admin_show_attribute_admin_show_attribute", "label": "Admin Attribute Show/Edit Page (admin_show_attribute)", "file_type": "code", "source_file": "templates/admin/admin_show_attribute.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "admin_page_view_model", "label": "Admin Page View-Model Key Contract (.TITLE/.MESSAGE/.ERRORS/.OLDS/.AUTH)", "file_type": "concept", "source_file": "templates/admin/admin_show_attribute.html", "rationale": "Every admin page reads the same flat top-level keys \u2014 TITLE (page heading), MESSAGE (flash feedback), ERRORS.<field> (per-field validation), OLDS.<field> (form repopulation), AUTH (session identity) \u2014 from a single map passed as '.'. This is a map[string]any view model, so there is no compile-time type checking: a handler returning the wrong key produces an empty render, not an error.", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "debug_context_dump_pattern", "label": "Template Debug Context Dump", "file_type": "concept", "source_file": "templates/admin/admin_show_attribute.html", "rationale": "Three admin pages contain leftover debugging: a {{range $a,$key:=.}} dump of the whole view model (admin_show_attribute.html, admin_login.html) plus a stray 'ss' literal and a .AUTH.FirstName probe. Because the view model is map[string]any, this is the only in-template way to inspect it, and it leaks session fields into the rendered admin page.", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "templates_admin_admin_show_attribute_admin_show_attribute", "target": "templates_layouts_head_head", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "templates/admin/admin_show_attribute.html", "source_location": null, "weight": 1.0}, {"source": "template