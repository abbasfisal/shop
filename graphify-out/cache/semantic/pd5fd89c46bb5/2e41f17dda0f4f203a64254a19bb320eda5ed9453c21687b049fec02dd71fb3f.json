{"nodes": [{"id": "templates_admin_admin_show_brand_show_brand", "label": "Admin Brand Show Page (show-brand)", "file_type": "code", "source_file": "templates/admin/admin_show_brand.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "upload_media_path_contract", "label": "Upload Media Path Contract (/uploads/media/...)", "file_type": "rationale", "source_file": "templates/admin/admin_show_brand.html", "rationale": "Image fields are rendered as '/uploads/media/<folder>/<file>' where only the stored file name comes from the entity (.BRAND.Image, .CATEGORY.Image). Handlers must therefore return a bare relative filename, not a full URL or path \u2014 a full URL would produce '/uploads/media/brands//uploads/...'.", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "admin_readonly_form_pattern", "label": "Read-only Form Pattern (DISABLED inputs in a formless table)", "file_type": "concept", "source_file": "templates/admin/admin_show_brand.html", "rationale": "Read-only show pages are built as a <form> with no action containing only DISABLED inputs, so a brand looks editable but submits nothing; this reuses show-form CSS at the cost of implying editability. admin_show_brand.html omits the edit route entirely while admin_show_category.html links to /admins/categories/{id}/edit, showing the show pages are not uniform.", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "templates_admin_admin_show_brand_show_brand", "target": "templates_layouts_head_head", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "templates/admin/admin_show_brand.html", "source_location": null, "weight": 1.0}, {"source": "templates_admin_admin_show_brand_show_brand", "target": "templates_layouts_navbar_navbar", "relation": "references", "confidence": "EXTRAC