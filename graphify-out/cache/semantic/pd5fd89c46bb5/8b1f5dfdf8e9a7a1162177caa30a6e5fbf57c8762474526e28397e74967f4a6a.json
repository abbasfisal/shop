{"nodes": [{"id": "templates_admin_admin_show_order_admin_show_order", "label": "Admin Order Show Page (admin_show_order)", "file_type": "code", "source_file": "templates/admin/admin_show_order.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "admin_order_status_transition", "label": "Admin Order Status Transition (states 0-11)", "file_type": "concept", "source_file": "templates/admin/admin_show_order.html", "rationale": "The order status state machine (0 paying, 1 paid, 2 cancelled, 3 preparing, 4 ready-to-ship, 5 shipped, 6 in-transit, 7 delivered, 8 returned, 9 completed, 10 dispute, 11 unknown) is duplicated verbatim in the template's <select>, driven by the numeric Data.OrderStatus and accompanied by Data.OrderStatusText. The enum is therefore owned by the HTML as well as the Go domain, so adding a state requires a coordinated template change or the new state is unreachable from the admin UI.", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "order_item_attribute_snapshot", "label": "Order Item Attribute Snapshot", "file_type": "concept", "source_file": "templates/admin/admin_show_order.html", "rationale": "Order lines render a nested range over .OrderItemAttributes.Data, meaning the order read model denormalizes the chosen attribute Title/Value pair onto each item so historical orders stay readable after a product's attributes change. The view depends on that snapshot rather than resolving attributes live from the catalog.", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "templates_admin_admin_show_order_admin_show_order", "target": "templates_layouts_head_head", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "templates/admin/admin_show_order.html", "source_location": null, "weight": 1.0}, {"source": "templa